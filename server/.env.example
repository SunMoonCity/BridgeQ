PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/techno_bridge?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://127.0.0.1:5500
NODE_ENV=development

# Admin seed credentials — used only by: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_ROLL_NO=ADMIN001
ADMIN_PASSWORD=change_this_strong_password
